# Ohmni: server-only secrets. Do not commit real credentials or .env.local.
GEMINI_API_KEY=
# Actual tested free-tier model ID; do not assume 3.8 access.
GEMINI_MODEL=gemini-3.5-flash
# Jev via BeatAPI gateway, FREE model only (paid ids are refused in code). Free tier: 1 successful call/min.
BEATAPI_API_KEY=
BEATAPI_JEV_MODEL=jev-1.13-free
GROQ_API_KEY=
# Groq vision backup (free tier); used only when Gemini fails
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Vision order: groq (default, measured faster/more available) or gemini. The other provider is the one-shot fallback.
VISION_PRIMARY=groq
# /api/explain tutor model (Gemini free tier, separate quota from vision)
EXPLAIN_MODEL=gemini-3.5-flash-lite
# Saved investigations (/api/v1/*). Unset = persistence disabled (503 PERSISTENCE_DISABLED). Server-only:
# the service-role key bypasses RLS and is used only for engine output after the caller's access is proven.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser sign-in for saved investigations (publishable key; safe to expose). Unset = saving hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shared (cross-instance) limits for model routes via Supabase public.rate_hit. On automatically when SUPABASE_* is set;
# RATE_SHARED=off disables. RATE_SALT salts the hashed client-IP keys (optional: defaults to a value derived from the
# server-only service-role key, never a public constant).
RATE_SHARED=
RATE_SALT=
# Demo account for scripts/seed-demo.mjs (local/dev only; created if missing). Never commit real values.
DEMO_EMAIL=
DEMO_PASSWORD=
